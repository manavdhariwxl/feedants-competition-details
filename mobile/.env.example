# Copy to `.env` and adjust for your setup.
#
# Points the app at the backend API. Notes:
# - iOS Simulator: http://localhost:4000 works fine.
# - Android Emulator: use http://10.0.2.2:4000 (localhost inside the emulator refers to
#   the emulator itself, not your host machine).
# - Physical device (Expo Go): use your computer's LAN IP, e.g. http://192.168.1.23:4000,
#   and make sure the phone is on the same network as the backend.
EXPO_PUBLIC_API_URL=http://localhost:4000
