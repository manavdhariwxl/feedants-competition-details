# Copy this file to `.env` and fill in real values. Never commit the real `.env` file.

# Port the Express server listens on
PORT=4000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/feedants
# Atlas:  mongodb+srv://<user>:<password>@<cluster-url>/feedants?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/feedants

# Comma-separated list of origins allowed to call this API (React Native / Expo dev server, web, etc.)
CORS_ORIGIN=*

# Node environment: development | production | test
NODE_ENV=development
